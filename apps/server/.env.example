# Environment Variables - Server

# =====================================================
# DEVELOPMENT SETUP (without AWS Secrets Manager)
# =====================================================
# Set NODE_ENV=development to use local .env file
NODE_ENV=development

# Server Configuration
PORT=8000

# Frontend URL(s) - comma-separated for multiple origins
FRONTEND_URL=http://localhost:3000

# JWT Secret - Generate a secure random string (minimum 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your-secure-random-jwt-secret-here-minimum-32-chars

# AWS Cognito Configuration
AWS_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
AWS_COGNITO_CLIENT_ID=your-cognito-client-id
AWS_COGNITO_CLIENT_SECRET=your-cognito-client-secret
AWS_COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
AWS_COGNITO_REDIRECT_URI=http://localhost:8000/api/v1/auth/cognito/callback

# OAuth Success/Failure Redirect URLs
SUCCESS_OAUTH_URL=http://localhost:3000/auth-success
FAILED_OAUTH_URL=http://localhost:3000/?error=auth_failed

# Atlassian/Jira Integration (Optional)
ATLASSIAN_CLIENT_ID=your-atlassian-client-id
ATLASSIAN_CLIENT_SECRET=your-atlassian-client-secret
ATLASSIAN_CALLBACK_URI=http://localhost:8000/api/v1/auth/jira/callback

# AWS Configuration for DynamoDB
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS Bedrock for AI (Optional)
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# =====================================================
# PRODUCTION SETUP (with AWS Secrets Manager)
# =====================================================
# Uncomment these and comment out the above for production

# AWS Secrets Manager Configuration
# AWS_SECRETS_MANAGER_SECRET_ID=ops-ninja/production
# AWS_SECRETS_MANAGER_REGION=us-east-1
# AWS_SECRETS_MANAGER_ACCESS_KEY_ID=your-access-key
# AWS_SECRETS_MANAGER_SECRET_ACCESS_KEY=your-secret-key

# Note: When using Secrets Manager, store all other secrets
# as a JSON object in AWS Secrets Manager with the same keys
